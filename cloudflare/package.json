{
  "name": "sopokdate-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx wrangler dev",
    "deploy": "npx wrangler deploy --env production",
    "db:create": "npx wrangler d1 create sopokdate-db",
    "db:schema": "npx wrangler d1 execute sopokdate-db --file=db/schema.sql --remote",
    "db:schema:local": "npx wrangler d1 execute sopokdate-db --file=db/schema.sql --local",
    "db:migrate:local": "npx wrangler d1 execute sopokdate-db --file=db/migration_add_nik_wali.sql --local",
    "db:migrate": "npx wrangler d1 execute sopokdate-db --file=db/migration_add_nik_wali.sql --remote",
    "db:seed": "npx wrangler d1 execute sopokdate-db --file=db/seed.sql --remote",
    "db:seed:local": "npx wrangler d1 execute sopokdate-db --file=db/seed.sql --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.0.0",
    "wrangler": "^3.100.0"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "hono": "^4.12.25"
  }
}
